<?xml version="1.0"?>
<sdf version="1.6">
  <model name="turtlebot3_burger_low_lidar">
    <pose>0 0 0 0 0 0</pose>

    <link name="base_footprint"/>

    <link name="base_link">
      <inertial>
        <pose>0 0 0.042 0 0 0</pose>
        <mass>0.82573504</mass>
        <inertia>
          <ixx>0.002257</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.002045</iyy>
          <iyz>0</iyz>
          <izz>0.002814</izz>
        </inertia>
      </inertial>
      <collision name="base_collision">
        <pose>0 0 0.052 0 0 0</pose>
        <geometry><box><size>0.138 0.149 0.104</size></box></geometry>
      </collision>
      <visual name="base_visual">
        <pose>0 0 0 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://turtlebot3_burger_low_lidar/meshes/burger_base_without_top.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.3 0.3 0.3 1</ambient>
          <diffuse>0.3 0.3 0.3 1</diffuse>
        </material>
      </visual>
      <sensor name="base_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact><collision>base_collision</collision></contact>
        <plugin name="base_contact_ros" filename="libgazebo_ros_bumper.so">
          <ros>
            <namespace>/gazebo/contacts</namespace>
            <remapping>bumper_states:=base</remapping>
          </ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
    </link>

    <link name="imu_link">
      <sensor name="tb3_imu" type="imu">
        <always_on>true</always_on>
        <update_rate>200</update_rate>
        <imu>
          <angular_velocity>
            <x><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>2e-4</stddev></noise></z>
          </angular_velocity>
          <linear_acceleration>
            <x><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></x>
            <y><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></y>
            <z><noise type="gaussian"><mean>0</mean><stddev>1.7e-2</stddev></noise></z>
          </linear_acceleration>
        </imu>
        <plugin name="turtlebot3_imu" filename="libgazebo_ros_imu_sensor.so">
          <ros><remapping>~/out:=imu</remapping></ros>
        </plugin>
      </sensor>
    </link>

    <link name="base_scan">
      <inertial>
        <pose>-0.020 0 0.110 0 0 0</pose>
        <mass>0.114</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name="lidar_sensor_collision">
        <pose>-0.020 0 0.110 0 0 0</pose>
        <geometry><cylinder><radius>0.0508</radius><length>0.055</length></cylinder></geometry>
      </collision>
      <visual name="lidar_sensor_visual">
        <pose>-0.032 0 0.120 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://turtlebot3_common/meshes/sensors/lds.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material>
          <ambient>0.2 0.2 0.2 1</ambient>
          <diffuse>0.2 0.2 0.2 1</diffuse>
        </material>
      </visual>
      <sensor name="hls_lfcd_lds" type="ray">
        <always_on>true</always_on>
        <visualize>false</visualize>
        <pose>-0.032 0 0.120 0 0 0</pose>
        <update_rate>5</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>360</samples><resolution>1</resolution>
              <min_angle>0</min_angle><max_angle>6.28</max_angle>
            </horizontal>
          </scan>
          <range><min>0.12</min><max>3.5</max><resolution>0.015</resolution></range>
          <noise><type>gaussian</type><mean>0</mean><stddev>0.01</stddev></noise>
        </ray>
        <plugin name="turtlebot3_laserscan" filename="libgazebo_ros_ray_sensor.so">
          <ros><remapping>~/out:=scan</remapping></ros>
          <output_type>sensor_msgs/LaserScan</output_type>
          <frame_name>base_scan</frame_name>
        </plugin>
      </sensor>
      <sensor name="lidar_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact><collision>lidar_sensor_collision</collision></contact>
        <plugin name="lidar_contact_ros" filename="libgazebo_ros_bumper.so">
          <ros>
            <namespace>/gazebo/contacts</namespace>
            <remapping>bumper_states:=lidar</remapping>
          </ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
    </link>

    <link name="wheel_left_link">
      <inertial>
        <pose>0 0.08 0.023 -1.57 0 0</pose>
        <mass>0.02849894</mass>
        <inertia>
          <ixx>0.0018158194</ixx><ixy>-9.3392e-12</ixy><ixz>1.04909e-11</ixz>
          <iyy>0.0032922126</iyy><iyz>5.75694e-11</iyz><izz>0.0018158194</izz>
        </inertia>
      </inertial>
      <collision name="wheel_left_collision">
        <pose>0 0.08 0.023 -1.57 0 0</pose>
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>100000</mu><mu2>100000</mu2><slip1>0</slip1><slip2>0</slip2></ode></friction>
          <contact><ode><kp>1e5</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="wheel_left_visual">
        <pose>0 0.08 0.023 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://turtlebot3_common/meshes/wheels/left_tire.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <sensor name="wheel_left_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact><collision>wheel_left_collision</collision></contact>
        <plugin name="wheel_left_contact_ros" filename="libgazebo_ros_bumper.so">
          <ros>
            <namespace>/gazebo/contacts</namespace>
            <remapping>bumper_states:=wheel_left</remapping>
          </ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
    </link>

    <link name="wheel_right_link">
      <inertial>
        <pose>0 -0.08 0.023 -1.57 0 0</pose>
        <mass>0.02849894</mass>
        <inertia>
          <ixx>0.0018158194</ixx><ixy>-9.3392e-12</ixy><ixz>1.04909e-11</ixz>
          <iyy>0.0032922126</iyy><iyz>5.75694e-11</iyz><izz>0.0018158194</izz>
        </inertia>
      </inertial>
      <collision name="wheel_right_collision">
        <pose>0 -0.08 0.023 -1.57 0 0</pose>
        <geometry><cylinder><radius>0.033</radius><length>0.018</length></cylinder></geometry>
        <surface>
          <friction><ode><mu>100000</mu><mu2>100000</mu2><slip1>0</slip1><slip2>0</slip2></ode></friction>
          <contact><ode><kp>1e5</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact>
        </surface>
      </collision>
      <visual name="wheel_right_visual">
        <pose>0 -0.08 0.023 0 0 0</pose>
        <geometry>
          <mesh>
            <uri>model://turtlebot3_common/meshes/wheels/right_tire.stl</uri>
            <scale>0.001 0.001 0.001</scale>
          </mesh>
        </geometry>
        <material><ambient>0.2 0.2 0.2 1</ambient><diffuse>0.2 0.2 0.2 1</diffuse></material>
      </visual>
      <sensor name="wheel_right_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact><collision>wheel_right_collision</collision></contact>
        <plugin name="wheel_right_contact_ros" filename="libgazebo_ros_bumper.so">
          <ros>
            <namespace>/gazebo/contacts</namespace>
            <remapping>bumper_states:=wheel_right</remapping>
          </ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
    </link>

    <link name="caster_back_link">
      <pose>-0.081 0 -0.004 -1.57 0 0</pose>
      <inertial>
        <mass>0.005</mass>
        <inertia>
          <ixx>0.001</ixx><ixy>0</ixy><ixz>0</ixz>
          <iyy>0.001</iyy><iyz>0</iyz><izz>0.001</izz>
        </inertia>
      </inertial>
      <collision name="caster_collision">
        <geometry><sphere><radius>0.005</radius></sphere></geometry>
        <surface><contact><ode><kp>1e5</kp><kd>1</kd><max_vel>0.01</max_vel><min_depth>0.001</min_depth></ode></contact></surface>
      </collision>
      <sensor name="caster_contact_sensor" type="contact">
        <always_on>true</always_on>
        <update_rate>100</update_rate>
        <contact><collision>caster_collision</collision></contact>
        <plugin name="caster_contact_ros" filename="libgazebo_ros_bumper.so">
          <ros>
            <namespace>/gazebo/contacts</namespace>
            <remapping>bumper_states:=caster</remapping>
          </ros>
          <frame_name>world</frame_name>
        </plugin>
      </sensor>
    </link>

    <joint name="base_joint" type="fixed">
      <parent>base_footprint</parent><child>base_link</child>
      <pose>0 0 0.010 0 0 0</pose>
    </joint>
    <joint name="wheel_left_joint" type="revolute">
      <parent>base_link</parent><child>wheel_left_link</child>
      <pose>0 0.08 0.023 -1.57 0 0</pose>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="wheel_right_joint" type="revolute">
      <parent>base_link</parent><child>wheel_right_link</child>
      <pose>0 -0.08 0.023 -1.57 0 0</pose>
      <axis><xyz>0 0 1</xyz></axis>
    </joint>
    <joint name="caster_back_joint" type="ball">
      <parent>base_link</parent><child>caster_back_link</child>
    </joint>
    <joint name="imu_joint" type="fixed">
      <parent>base_link</parent><child>imu_link</child>
      <pose>-0.032 0 0.068 0 0 0</pose>
    </joint>
    <joint name="lidar_joint" type="fixed">
      <parent>base_link</parent><child>base_scan</child>
      <pose>-0.032 0 0.120 0 0 0</pose>
    </joint>
    <plugin name="turtlebot3_diff_drive" filename="libgazebo_ros_diff_drive.so">
      <ros/>
      <update_rate>30</update_rate>
      <left_joint>wheel_left_joint</left_joint>
      <right_joint>wheel_right_joint</right_joint>
      <wheel_separation>0.160</wheel_separation>
      <wheel_diameter>0.066</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1</max_wheel_acceleration>
      <command_topic>cmd_vel</command_topic>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>false</publish_wheel_tf>
      <odometry_topic>odom</odometry_topic>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>

    <plugin name="turtlebot3_joint_state" filename="libgazebo_ros_joint_state_publisher.so">
      <ros><remapping>~/out:=joint_states</remapping></ros>
      <update_rate>30</update_rate>
      <joint_name>wheel_left_joint</joint_name>
      <joint_name>wheel_right_joint</joint_name>
    </plugin>
  </model>
</sdf>
